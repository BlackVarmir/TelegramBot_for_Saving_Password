# ══════════════════════════════════════════════════════════════
#  .env.example — Приклад конфігурації
#  Скопіюйте цей файл у .env і заповніть реальними значеннями.
#  Файл .env НЕ комітиться (див. .gitignore).
# ══════════════════════════════════════════════════════════════

# ── Telegram Bot ──────────────────────────────────────────────
# Отримати у @BotFather. НІКОЛИ не вписуйте токен у код!
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Шифрування сховища (Fernet) ───────────────────────────────
# Згенерувати:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key_here_base64_encoded=

# ── Контроль доступу ──────────────────────────────────────────
# Ваш числовий Telegram ID. Дізнатись: запустіть бота і надішліть /whoami.
# Кілька користувачів — через кому: 111111111,222222222
ALLOWED_USER_IDS=

# ── База даних ────────────────────────────────────────────────
# Рекомендовано (особливо на спільному PostgreSQL): окрема база з УНІКАЛЬНОЮ
# назвою, щоб не конфліктувати з іншими проєктами. Кожна база має власний
# набір таблиць, тож таблиці бота ні з чим не зіткнуться.
#   1) у psql (одноразово):  CREATE DATABASE tg_password_manager_bot;
#   2) впишіть назву в кінець URL:
DATABASE_URL=postgresql+asyncpg://botuser:botpass@localhost:5432/tg_password_manager_bot

# Швидкий тест без CREATE DATABASE — стандартна база "postgres" (існує завжди):
# DATABASE_URL=postgresql+asyncpg://botuser:botpass@localhost:5432/postgres

# SQLite (локальна розробка, без сервера):
# DATABASE_URL=sqlite+aiosqlite:///passwords.db

# Використовується лише docker compose (вбудований сервіс postgres):
POSTGRES_DB=tg_password_manager_bot
POSTGRES_USER=botuser
POSTGRES_PASSWORD=botpass

# ── Необов'язкові ─────────────────────────────────────────────
# Стандартний зсув шифру Цезаря (1-25)
DEFAULT_CAESAR_SHIFT=3
